# Server-side only. Never expose this in the browser or a VITE_ variable.
GEMMA_API_KEY=

# Defaults to Google's Generative Language API.
GEMMA_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional Google Gemma API model ID.
GEMMA_MODEL=gemma-4-31b-it

# Optional comma-separated list of trusted frontend origins for CORS.
# Leave blank to allow same-origin or no explicit origin checks.
ALLOWED_ORIGINS=

# Optional local-only port for the Express server.
PORT=3000
